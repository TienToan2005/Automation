# Sao chép thành .env rồi sửa. Tất cả đều tùy chọn (có giá trị mặc định cho môi trường dev).
LAB_SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
LAB_SERVICE_TOKEN=dev-service-token
LAB_DEVICE_TOKEN=dev-device-token
LAB_AI_BASE_URL=http://127.0.0.1:5050
LAB_ADMIN_ID=admin
LAB_ADMIN_PASSWORD=admin123
# LAB_DATABASE_URL=postgresql+psycopg://user:pass@localhost/lab

# --- Thông báo tức thời (tùy chọn): kênh nào đủ cấu hình thì tự bật. Xem README mục 5 ---
# LAB_TELEGRAM_BOT_TOKEN=123456:ABC-DEF            # tạo bot bằng @BotFather
# LAB_TELEGRAM_CHAT_ID=123456789                   # id chat / nhóm nhận tin (nhóm có id âm)
# LAB_SMTP_HOST=smtp.gmail.com
# LAB_SMTP_PORT=587                                # 465 = SSL
# LAB_SMTP_USER=ten@gmail.com
# LAB_SMTP_PASSWORD=mat-khau-ung-dung              # Gmail: mật khẩu ứng dụng, không phải mật khẩu đăng nhập
# LAB_SMTP_TO=nguoi1@example.com,nguoi2@example.com
# LAB_NOTIFY_MIN_LEVEL=medium                     # info | medium | high: mức tối thiểu để đẩy ra Telegram / Email
# LAB_NOTIFY_COOLDOWN_S=30                        # cùng loại sự kiện chỉ đẩy một lần trong khoảng này
# LAB_PUBLIC_BASE_URL=http://192.168.1.10:8080    # để tin nhắn kèm link tới trang web

# --- ThingsBoard (tùy chọn): mỗi sự kiện cửa được đẩy lên làm telemetry. Để trống = tắt ---
# LAB_THINGSBOARD_URL=https://thingsboard.cloud/api/v1/<TOKEN-CUA-THIET-BI>/telemetry

# --- Chính sách xác thực / khóa tạm (xem docs/NGHIEP_VU_XAC_THUC.md). Giá trị khởi điểm, cần hiệu chỉnh bằng dữ liệu thật ---
# LAB_MISMATCH_LOCK_THRESHOLD=3                   # số lần face_mismatch ĐÃ XÁC NHẬN trong cửa sổ thì khóa tạm thẻ
# LAB_MISMATCH_WINDOW_S=300
# LAB_SPOOF_LOCK_THRESHOLD=3                      # bộ đếm riêng cho spoof_pad
# LAB_SPOOF_WINDOW_S=900
# LAB_LIVENESS_LOCK_THRESHOLD=5                   # bộ đếm riêng cho challenge_failed
# LAB_LIVENESS_WINDOW_S=900
# LAB_LOCK_BASE_S=300                             # cooldown 5 -> 15 -> 30 phút (nhân 3, có trần LAB_LOCK_CAP_S)
# LAB_LOCK_CAP_S=1800
# LAB_LOCK_LEVEL_DECAY_S=86400                    # yên ổn quá ngần này giây thì bậc cooldown về 1
# LAB_SCAN_RATE_PER_UID_PER_MIN=6                 # giới hạn tần suất quẹt (429), không tính vào bộ đếm lỗi
# LAB_SCAN_RATE_PER_DEVICE_PER_MIN=30
# LAB_SESSION_GRACE_S=5

# Múi giờ của báo cáo và bộ lọc ngày (Việt Nam = 7)
# LAB_UTC_OFFSET_HOURS=7
