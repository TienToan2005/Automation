# --- Thông báo tức thời (tùy chọn): kênh nào đủ cấu hình thì tự bật. Xem README mục 5 ---
# LAB_TELEGRAM_BOT_TOKEN=123456:ABC-DEF            # tạo bot bằng @BotFather
# LAB_TELEGRAM_CHAT_ID=123456789                   # id chat / nhóm nhận tin (nhóm có id âm)
# LAB_SMTP_HOST=smtp.gmail.com
# LAB_SMTP_PORT=587                                # 465 = SSL
# LAB_SMTP_USER=ten@gmail.com
# LAB_SMTP_PASSWORD=mat-khau-ung-dung              # Gmail: mật khẩu ứng dụng, không phải mật khẩu đăng nhập
# LAB_SMTP_TO=nguoi1@example.com,nguoi2@example.com
# LAB_NOTIFY_MIN_LEVEL=medium                     # info | medium | high: mức tối thiểu để đẩy ra Telegram / Email
# LAB_NOTIFY_COOLDOWN_S=30                        # cùng loại sự kiện chỉ đẩy một lần trong khoảng này
# LAB_PUBLIC_BASE_URL=http://192.168.1.10:8080    # để tin nhắn kèm link tới trang web

# Múi giờ của báo cáo và bộ lọc ngày (Việt Nam = 7)
# LAB_UTC_OFFSET_HOURS=7
